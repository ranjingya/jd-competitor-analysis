# StarRocks 使用 MySQL 协议连接。
DB_DRIVER=mysql+pymysql
DB_HOST=
# 9030 是 StarRocks 常用查询端口，请按实际配置调整。
DB_PORT=9030
DB_NAME=
DB_USER=
DB_PASSWORD=

# 也可改用完整 SQLAlchemy URL；设置后优先于上面的分项连接参数。
DB_URL=

# 连接探测参数。
DB_CONNECT_TIMEOUT=10
DB_TEST_TABLE=ods_rpa_jdzy_competitor_data_compare_f
DB_TEST_LIMIT=5

# Backend 任务租约时长，单位为秒。
TASK_LEASE_SECONDS=1800

# Backend 标准化数据、AI 任务和报告共用的 SQLite 数据库。
BACKEND_DATABASE_PATH=data/backend.db

# Mac Codex Worker 调用任务接口时使用的专用长随机令牌。
AI_WORKER_TOKEN=

# 飞书应用身份，仅用于读取 SPU/SKU 映射多维表。
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_TOKEN=
# SPU/SKU 五字段映射表。
LARK_TABLE_ID=
# 本品 SPU 与竞品 SPU 候选商品对表。
LARK_PAIR_TABLE_ID=
LARK_REQUEST_TIMEOUT=30
LARK_PAGE_SIZE=500
