# StarRocks 使用 MySQL 协议连接。
DB_DRIVER=mysql+pymysql
DB_HOST=
# 9030 是 StarRocks 常用查询端口，请按实际配置调整。
DB_PORT=9030
DB_NAME=
DB_USER=
DB_PASSWORD=

# 也可改用完整 SQLAlchemy URL；设置后优先于上面的分项连接参数。
DB_URL=

# 连接探测参数。
DB_CONNECT_TIMEOUT=10
DB_TEST_TABLE=ods_rpa_jdzy_competitor_data_compare_f
DB_TEST_LIMIT=5

# Backend 标准化数据、AI 执行记录和报告共用的 SQLite 数据库。
BACKEND_DATABASE_PATH=data/data.db
# 日周月分析共用互斥锁；为空时默认与数据库位于同一目录。
ANALYSIS_LOCK_PATH=data/warehouse-daily-run.lock

# 宿主机定时分析脚本使用的 Healthchecks Ping 地址。
HEALTHCHECKS_PING_URL=

# DeepSeek 使用 OpenAI 兼容协议生成总结、发现和建议。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=300
DEEPSEEK_MAX_ATTEMPTS=2

# 飞书应用身份，仅用于读取 SPU/SKU 映射多维表。
LARK_APP_ID=
LARK_APP_SECRET=
LARK_BASE_TOKEN=
# SPU/SKU 五字段映射表。
LARK_TABLE_ID=
# 本品 SPU 与竞品 SPU 候选商品对表。
LARK_PAIR_TABLE_ID=
LARK_REQUEST_TIMEOUT=30
LARK_PAGE_SIZE=500
